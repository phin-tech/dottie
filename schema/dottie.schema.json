{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phin-tech/dottie/schema/dottie.schema.json",
  "title": "Dottie drawing (.dottie)",
  "description": "A Dottie drawing as DottieKit reads and writes it. Kept in step with the Swift model: DottieKitTests/SchemaTests checks that every fixture and every encoded model validates, and that every stored property of the model types is listed here. A change to the model that isn't made here fails that test, which is the prompt to update dottie.js (web/) too. Required fields are the ones DottieKit's decoders need; everything else may be left out.",
  "$ref": "#/$defs/file",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "file": {
      "type": "object",
      "required": ["version", "pages"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "description": "2 for files with pages." },
        "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
        "images": {
          "type": "object",
          "description": "Each picture once, keyed by the SHA-256 of its bytes; image elements refer to it.",
          "additionalProperties": { "$ref": "#/$defs/inlineImage" }
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "name", "layers", "elements"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
        "elements": { "type": "array", "description": "Back to front within each layer.", "items": { "$ref": "#/$defs/element" } },
        "theme": { "type": "string", "description": "paper, white, sepia, blueprint, chalkboard or midnight." },
        "guidesX": { "type": "array", "items": { "type": "number" } },
        "guidesY": { "type": "array", "items": { "type": "number" } },
        "guidesLocked": { "type": "boolean" },
        "timeline": { "$ref": "#/$defs/timeline" },
        "symbols": { "type": "array", "description": "Drawings placed by symbol elements, each with its own animation.", "items": { "$ref": "#/$defs/symbol" } }
      }
    },
    "symbol": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "width": { "type": "number", "description": "The box its elements are drawn in, from the origin; instances scale it into their frame." },
        "height": { "type": "number" },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
        "timeline": { "$ref": "#/$defs/timeline" },
        "button": { "type": "boolean", "description": "Copies show its up scene (or the start); on the web its over and down scenes, and its hit scene takes clicks." },
        "params": { "type": "object", "additionalProperties": { "type": "string" }, "description": "What each copy can fill in: parameter names and their defaults. {{name}} in the symbol's text is replaced by a copy's value." }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "name", "visible", "locked"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" }
      }
    },
    "rgba": {
      "type": "object",
      "required": ["r", "g", "b", "a"],
      "additionalProperties": false,
      "properties": {
        "r": { "type": "number" },
        "g": { "type": "number" },
        "b": { "type": "number" },
        "a": { "type": "number" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stroke": { "$ref": "#/$defs/rgba" },
        "fill": { "$ref": "#/$defs/rgba" },
        "fillStyle": { "enum": ["solid", "hachure", "crossHatch", "grid"] },
        "strokeWidth": { "type": "number" },
        "dash": { "enum": ["solid", "dashed", "dotted"] },
        "roughness": { "type": "number" },
        "bowing": { "type": "number" },
        "fontSize": { "type": "number" },
        "font": {
          "type": "string",
          "description": "The font text is set in. Absent is Helvetica Neue; Caveat, Patrick Hand and Architects Daughter are bundled and embedded in exports; any other name is a font installed where the drawing is viewed, never embedded."
        },
        "gridSize": { "type": "number" },
        "opacity": { "type": "number" },
        "dashOffset": { "type": "number" }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "kind", "x", "y", "width", "height", "style", "seed", "layerID"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["rectangle", "ellipse", "diamond", "text", "connector", "freehand", "path", "note", "image", "symbol"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "style": { "$ref": "#/$defs/style" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "layerID": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string" },
        "connector": { "$ref": "#/$defs/connector" },
        "groupID": { "$ref": "#/$defs/uuid" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/strokePoint" } },
        "path": { "type": "array", "items": { "type": "number" }, "description": "Fitted cubic Béziers, normalized: start, then c1, c2, end per segment." },
        "subpaths": { "type": "array", "items": { "$ref": "#/$defs/subpath" } },
        "evenOdd": { "type": "boolean" },
        "rotation": { "type": "number", "description": "Radians, clockwise about the frame's center." },
        "link": { "$ref": "#/$defs/uuid" },
        "url": { "type": "string", "description": "Where the element links outside the drawing, instead of link: an http, https or mailto address, or another drawing as a path relative to this file with an optional #anchor (or page name)" },
        "anchor": { "type": "string" },
        "click": { "$ref": "#/$defs/click" },
        "hover": { "$ref": "#/$defs/hover" },
        "symbol": { "$ref": "#/$defs/uuid", "description": "For a symbol element: the page's symbol it shows." },
        "playback": { "enum": ["loop", "once", "still", "click"], "description": "How a symbol element plays its symbol's timeline; loop by default. click rests at the start and plays once when clicked in <dottie-player>." },
        "offset": { "type": "number", "description": "Seconds into its symbol's timeline a symbol element is when the page's starts." },
        "args": { "type": "object", "additionalProperties": { "type": "string" }, "description": "A symbol element's values for its symbol's params; ones it leaves out take the default." },
        "image": { "$ref": "#/$defs/image" },
        "reveal": { "type": "number" },
        "extension": { "$ref": "#/$defs/extensionRef", "description": "For a path made by an extension: the shape that generated its subpaths, and its parameters." },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/normalizedPoint" }, "description": "For an extension shape: connection points, normalized to the frame." },
        "labelRect": { "$ref": "#/$defs/normalizedRect", "description": "For an extension shape: where its label goes, normalized to the frame." }
      }
    },
    "extensionRef": {
      "type": "object",
      "required": ["id", "shape", "version", "params"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "shape": { "type": "string" },
        "version": { "type": "string" },
        "params": { "type": "object", "additionalProperties": { "type": ["number", "boolean", "string"] } }
      }
    },
    "normalizedPoint": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "normalizedRect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number" }, "height": { "type": "number" }
      }
    },
    "strokePoint": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "subpath": {
      "type": "object",
      "required": ["closed", "coords"],
      "additionalProperties": false,
      "properties": {
        "closed": { "type": "boolean" },
        "coords": { "type": "array", "items": { "type": "number" } }
      }
    },
    "inlineImage": {
      "type": "object",
      "required": ["data"],
      "additionalProperties": false,
      "properties": {
        "data": { "type": "string", "description": "Base64 PNG or JPEG bytes." },
        "format": { "enum": ["png", "jpeg"] }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ref"],
          "additionalProperties": false,
          "properties": { "ref": { "type": "string", "description": "A key of the file's images table." } }
        },
        { "$ref": "#/$defs/inlineImage" }
      ]
    },
    "endpoint": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "elementID": { "$ref": "#/$defs/uuid" },
        "port": { "enum": ["top", "right", "bottom", "left"] },
        "portIndex": { "type": "integer", "minimum": 0, "description": "Pins the end to one of the bound extension shape's ports (its index in the element's ports)." },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "connector": {
      "type": "object",
      "required": ["start", "end", "routing", "startHead", "endHead"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/endpoint" },
        "end": { "$ref": "#/$defs/endpoint" },
        "routing": { "enum": ["straight", "curved", "elbow"] },
        "startHead": { "$ref": "#/$defs/arrowhead" },
        "endHead": { "$ref": "#/$defs/arrowhead" }
      }
    },
    "arrowhead": { "enum": ["none", "arrow", "triangle", "dot", "bar"] },
    "ease": { "enum": ["linear", "easeIn", "easeOut", "easeInOut", "hold", "spring", "bounce", "elastic"] },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "number" },
        "duration": { "type": "number" },
        "boil": { "type": "integer" },
        "settle": { "type": "boolean" },
        "poster": { "type": "number" },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "camera": { "type": "array", "items": { "$ref": "#/$defs/cameraKey" } },
        "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } }
      }
    },
    "track": {
      "type": "object",
      "required": ["element"],
      "additionalProperties": false,
      "properties": {
        "element": { "$ref": "#/$defs/uuid" },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/keyframe" } },
        "boil": { "type": "boolean" },
        "follow": { "type": "array", "items": { "$ref": "#/$defs/follow" } },
        "repeats": { "type": "array", "items": { "$ref": "#/$defs/repeat" } },
        "march": { "type": "number" }
      }
    },
    "keyframe": {
      "type": "object",
      "required": ["t"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "rotation": { "type": "number" },
        "strokeWidth": { "type": "number" },
        "stroke": { "$ref": "#/$defs/rgba" },
        "fill": { "$ref": "#/$defs/rgba" },
        "visible": { "type": "boolean" },
        "reveal": { "type": "number" },
        "opacity": { "type": "number" },
        "ease": { "$ref": "#/$defs/ease" }
      }
    },
    "follow": {
      "type": "object",
      "required": ["path", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/uuid" },
        "start": { "type": "number" },
        "end": { "type": "number" },
        "ease": { "$ref": "#/$defs/ease" },
        "reverse": { "type": "boolean" },
        "orient": { "type": "boolean" },
        "laps": { "type": "number" }
      }
    },
    "repeat": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "number" },
        "end": { "type": "number" },
        "count": { "type": "integer" }
      }
    },
    "cameraKey": {
      "type": "object",
      "required": ["t", "x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "ease": { "$ref": "#/$defs/ease" }
      }
    },
    "marker": {
      "type": "object",
      "required": ["t", "name"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "number" },
        "name": { "type": "string" }
      }
    },
    "click": {
      "type": "object",
      "description": "What clicking the element does when the drawing plays on the web. A scene wins over a url.",
      "additionalProperties": false,
      "properties": {
        "scene": { "type": "string", "description": "A marker's name: jump there and play on to the next scene." },
        "url": { "type": "string", "pattern": "^([Hh][Tt][Tt][Pp][Ss]?://|[Mm][Aa][Ii][Ll][Tt][Oo]:)", "description": "Opened in a new tab; readers drop any other scheme." }
      }
    },
    "hover": {
      "type": "object",
      "description": "How a clickable element looks under the pointer or with keyboard focus.",
      "additionalProperties": false,
      "properties": {
        "stroke": { "$ref": "#/$defs/rgba" },
        "fill": { "$ref": "#/$defs/rgba" },
        "opacity": { "type": "number" }
      }
    }
  }
}
