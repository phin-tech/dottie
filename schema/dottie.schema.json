{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phin-tech/dottie/schema/dottie.schema.json",
  "title": "Dottie drawing (.dottie)",
  "description": "A Dottie drawing as DottieKit reads and writes it. Kept in step with the Swift model: DottieKitTests/SchemaTests checks that every fixture and every encoded model validates, and that every stored property of the model types is listed here. A change to the model that isn't made here fails that test, which is the prompt to update dottie.js (web/) too. Required fields are the ones DottieKit's decoders need; everything else may be left out.",
  "$ref": "#/$defs/file",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "file": {
      "type": "object",
      "required": ["version", "pages"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "description": "2 for files with pages." },
        "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
        "images": {
          "type": "object",
          "description": "Each picture once, keyed by the SHA-256 of its bytes; image elements refer to it.",
          "additionalProperties": { "$ref": "#/$defs/inlineImage" }
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "name", "layers", "elements"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
        "elements": { "type": "array", "description": "Back to front within each layer.", "items": { "$ref": "#/$defs/element" } },
        "theme": { "type": "string", "description": "paper, white, sepia, blueprint, chalkboard or midnight." },
        "guidesX": { "type": "array", "items": { "type": "number" } },
        "guidesY": { "type": "array", "items": { "type": "number" } },
        "guidesLocked": { "type": "boolean" },
        "timeline": { "$ref": "#/$defs/timeline" }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "name", "visible", "locked"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" }
      }
    },
    "rgba": {
      "type": "object",
      "required": ["r", "g", "b", "a"],
      "additionalProperties": false,
      "properties": {
        "r": { "type": "number" },
        "g": { "type": "number" },
        "b": { "type": "number" },
        "a": { "type": "number" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stroke": { "$ref": "#/$defs/rgba" },
        "fill": { "$ref": "#/$defs/rgba" },
        "fillStyle": { "enum": ["solid", "hachure", "crossHatch", "grid"] },
        "strokeWidth": { "type": "number" },
        "dash": { "enum": ["solid", "dashed", "dotted"] },
        "roughness": { "type": "number" },
        "bowing": { "type": "number" },
        "fontSize": { "type": "number" },
        "gridSize": { "type": "number" },
        "opacity": { "type": "number" }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "kind", "x", "y", "width", "height", "style", "seed", "layerID"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["rectangle", "ellipse", "diamond", "text", "connector", "freehand", "path", "note", "image"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "style": { "$ref": "#/$defs/style" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "layerID": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string" },
        "connector": { "$ref": "#/$defs/connector" },
        "groupID": { "$ref": "#/$defs/uuid" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/strokePoint" } },
        "path": { "type": "array", "items": { "type": "number" }, "description": "Fitted cubic Béziers, normalized: start, then c1, c2, end per segment." },
        "subpaths": { "type": "array", "items": { "$ref": "#/$defs/subpath" } },
        "evenOdd": { "type": "boolean" },
        "rotation": { "type": "number", "description": "Radians, clockwise about the frame's center." },
        "link": { "$ref": "#/$defs/uuid" },
        "anchor": { "type": "string" },
        "image": { "$ref": "#/$defs/image" },
        "reveal": { "type": "number" }
      }
    },
    "strokePoint": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "subpath": {
      "type": "object",
      "required": ["closed", "coords"],
      "additionalProperties": false,
      "properties": {
        "closed": { "type": "boolean" },
        "coords": { "type": "array", "items": { "type": "number" } }
      }
    },
    "inlineImage": {
      "type": "object",
      "required": ["data"],
      "additionalProperties": false,
      "properties": {
        "data": { "type": "string", "description": "Base64 PNG or JPEG bytes." },
        "format": { "enum": ["png", "jpeg"] }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ref"],
          "additionalProperties": false,
          "properties": { "ref": { "type": "string", "description": "A key of the file's images table." } }
        },
        { "$ref": "#/$defs/inlineImage" }
      ]
    },
    "endpoint": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "elementID": { "$ref": "#/$defs/uuid" },
        "port": { "enum": ["top", "right", "bottom", "left"] },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "connector": {
      "type": "object",
      "required": ["start", "end", "routing", "startHead", "endHead"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/endpoint" },
        "end": { "$ref": "#/$defs/endpoint" },
        "routing": { "enum": ["straight", "curved", "elbow"] },
        "startHead": { "$ref": "#/$defs/arrowhead" },
        "endHead": { "$ref": "#/$defs/arrowhead" }
      }
    },
    "arrowhead": { "enum": ["none", "arrow", "triangle", "dot", "bar"] },
    "ease": { "enum": ["linear", "easeIn", "easeOut", "easeInOut", "hold", "spring", "bounce", "elastic"] },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "number" },
        "duration": { "type": "number" },
        "boil": { "type": "integer" },
        "settle": { "type": "boolean" },
        "poster": { "type": "number" },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "camera": { "type": "array", "items": { "$ref": "#/$defs/cameraKey" } },
        "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } }
      }
    },
    "track": {
      "type": "object",
      "required": ["element"],
      "additionalProperties": false,
      "properties": {
        "element": { "$ref": "#/$defs/uuid" },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/keyframe" } },
        "boil": { "type": "boolean" },
        "follow": { "type": "array", "items": { "$ref": "#/$defs/follow" } },
        "repeats": { "type": "array", "items": { "$ref": "#/$defs/repeat" } }
      }
    },
    "keyframe": {
      "type": "object",
      "required": ["t"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "rotation": { "type": "number" },
        "strokeWidth": { "type": "number" },
        "stroke": { "$ref": "#/$defs/rgba" },
        "fill": { "$ref": "#/$defs/rgba" },
        "visible": { "type": "boolean" },
        "reveal": { "type": "number" },
        "opacity": { "type": "number" },
        "ease": { "$ref": "#/$defs/ease" }
      }
    },
    "follow": {
      "type": "object",
      "required": ["path", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/uuid" },
        "start": { "type": "number" },
        "end": { "type": "number" },
        "ease": { "$ref": "#/$defs/ease" },
        "reverse": { "type": "boolean" },
        "orient": { "type": "boolean" },
        "laps": { "type": "number" }
      }
    },
    "repeat": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "number" },
        "end": { "type": "number" },
        "count": { "type": "integer" }
      }
    },
    "cameraKey": {
      "type": "object",
      "required": ["t", "x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "ease": { "$ref": "#/$defs/ease" }
      }
    },
    "marker": {
      "type": "object",
      "required": ["t", "name"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "number" },
        "name": { "type": "string" }
      }
    }
  }
}
